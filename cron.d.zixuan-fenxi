# 自选快照。本机 cron 按 UTC，时刻已换成北京时间对应的 UTC（东八区，无夏令时）。
# 北京 07:20 / 08:00 / 09:00-10:30每10分钟 / 11:30 / 13:00 / 13:30 / 14:00 / 14:30 / 14:50 / 15:00 / 15:10 / 22:00
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 07:20 北京 = 23:20 UTC 前一日（周日到周四 → 周一到周五）
20 23 * * 0-4 root /opt/zixuan-fenxi/run_cron.sh
# 08:00 北京 = 00:00 UTC
0 0 * * 1-6 root /opt/zixuan-fenxi/run_cron.sh
# 09:00-09:50 北京 = 01:00-01:50 UTC，每10分钟
0,10,20,30,40,50 1 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 10:00-10:30 北京 = 02:00-02:30 UTC，每10分钟
0,10,20,30 2 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 11:30 北京
30 3 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 13:00 北京
0 5 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 13:30 北京
30 5 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 14:00 北京
0 6 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 14:30 北京
30 6 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 14:50 北京（隔夜饭尾盘确认）
50 6 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 15:00 北京（收盘，胜率追踪填次日收）
0 7 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 15:10 北京（日K收盘价落地后再刷一版，避免 15:00 整点还是未定格）
10 7 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
# 22:00 北京
0 14 * * 1-5 root /opt/zixuan-fenxi/run_cron.sh
